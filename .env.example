# Shared by the Django API and the Vite app.
# Only names that start with VITE_ are visible in the browser.
# Copy this file to .env in this same folder.

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Karachi
LOG_LEVEL=INFO

# Database. USE_SQLITE=True ignores DATABASE_URL and uses backend/db.sqlite3.
USE_SQLITE=False
DATABASE_URL=postgres://hrm:hrm_dev_password@127.0.0.1:5433/hrm

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://hrm.wesolucions.com
SECURE_SSL_REDIRECT=True

# Sign-in tokens
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Upload limit for photos and leave documents, in megabytes
FILE_UPLOAD_MAX_MB=6

# Super user. prepare_workspace (local reset) creates this account and replaces its password.
# A production container runs ensure_superuser, which creates the account only when it is missing.
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=
SUPERUSER_FIRST_NAME=
SUPERUSER_LAST_NAME=

# Interactive API docs. Hidden automatically when DEBUG=False unless this is True.
SHOW_API_DOCS=True

# Used by docker-compose.prod.yml. Leave these blank for local development.
# POSTGRES_PASSWORD must not contain @ : / # or spaces.
POSTGRES_DB=hrm
POSTGRES_USER=hrm
POSTGRES_PASSWORD=
PUBLIC_HOST=hrm.wesolucions.com
HTTP_PORT=80
PUBLIC_API_URL=/api
